# 프론트엔드에서 호출할 백엔드(FastAPI) 주소
VITE_API_BASE_URL=http://localhost:8000
# VWorld 국가중점데이터 3종(토지·임야정보/개별공시지가/토지이용계획)을 브라우저에서 JSONP로 직접 호출할 때 쓴다.
# 빌드된 번들에 그대로 노출되니, backend/.env의 VWORLD_API_KEY와 같은 값을 넣되 이 키가
# 브라우저에 공개된다는 점을 감안한다(8-5 참조 — 키 발급 시 등록한 도메인의 Referer로만 동작함).
VITE_VWORLD_API_KEY=YOUR_API_KEY
VITE_VWORLD_DOMAIN=https://kyungdong.cloud